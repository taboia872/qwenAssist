<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <WebView
        android:id="@+id/chatWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Menu container — bookmark tab style, hugging the right edge
         When closed: only arrow tab visible (44dp wide)
         When open: full container slides left revealing URL bar + all buttons -->
    <LinearLayout
        android:id="@+id/menuBar"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:background="@drawable/glass_tab"
        android:gravity="center_vertical"
        android:padding="0dp"
        android:visibility="visible">

        <!-- Arrow button — leftmost in container, toggles menu -->
        <ImageButton
            android:id="@+id/btnMenuToggleInner"
            android:background="@android:color/transparent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Menu" />


        <ImageButton
            android:id="@+id/btnReload"
            android:background="@android:color/transparent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_reload"
            android:contentDescription="Reload"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            android:background="@android:color/transparent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="Fullscreen"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnClearData"
            android:background="@android:color/transparent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Clear all data"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:background="@android:color/transparent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnAbout"
            android:background="@android:color/transparent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_info"
            android:contentDescription="About"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
